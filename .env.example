CAMPMATE_EXECUTION_MODE=stub
# Enable only after the chosen non-stub Agent/Adapter has been registered.
CAMPMATE_PLANNING_ENABLED=false
CAMPMATE_DEMO_TODAY=2026-10-08
CAMPMATE_DATASET_PATH=data/synthetic_demo
# Optional run input JSON files under the selected package's data/scenarios/.
CAMPMATE_DATASET_SCENARIO_FILES=[]
# Server-selected scenario IDs/options; included in confirmation/run digests.
CAMPMATE_DATASET_SELECTION={}
# Explicit source safety cases for the registered rule workflow; no automatic choice.
CAMPMATE_WORKFLOW_SAFETY_CASE_IDS=[]
# Created and migrated on API startup; keep the generated database out of Git.
CAMPMATE_DATABASE_PATH=var/campmate.sqlite3
CAMPMATE_SEED_DEMO_ACCOUNTS=true
CAMPMATE_SESSION_HOURS=8
# Local HTTP demo. Use true when serving over HTTPS.
CAMPMATE_SECURE_COOKIES=false
