CAMPMATE_EXECUTION_MODE=stub
# Low-level dev.py defaults are conservative. scripts/sydney.py selects the
# current Sydney dataset and explicitly enables its registered planning mode.
CAMPMATE_PLANNING_ENABLED=false
# Model logistics is opt-in; the audit + Hybrid integration is included.
CAMPMATE_LOGISTICS_EXECUTION=rules
# Sydney 2.2 supports standard and compact model safety via explicit CLI flags.
CAMPMATE_SAFETY_EXECUTION=rules
# Normal operation reads the current Sydney date. A legacy DEMO_TODAY alone
# does not freeze normal operation. Set CLOCK_MODE=fixed for repeatable tests.
CAMPMATE_CLOCK_MODE=current
CAMPMATE_DEMO_TODAY=2026-10-08
# auto: daily synthetic snapshots for supported v2.1/v2.2 current-date input;
# fixed-date rehearsals must explicitly choose rolling, not auto.
CAMPMATE_SYNTHETIC_EVIDENCE_MODE=auto
CAMPMATE_SNAPSHOT_CACHE_PATH=var/daily-snapshots
CAMPMATE_DATASET_PATH=data/synthetic_demo
# Optional run input JSON files under the selected package's data/scenarios/.
CAMPMATE_DATASET_SCENARIO_FILES=[]
# Server-selected scenario IDs/options; included in confirmation/run digests.
CAMPMATE_DATASET_SELECTION={}
# Explicit source safety cases for the registered rule workflow; no automatic choice.
CAMPMATE_WORKFLOW_SAFETY_CASE_IDS=[]
# Created and migrated on API startup; keep the generated database out of Git.
CAMPMATE_DATABASE_PATH=var/campmate.sqlite3
CAMPMATE_SEED_DEMO_ACCOUNTS=true
CAMPMATE_SESSION_HOURS=8
# Local HTTP demo. Use true when serving over HTTPS.
CAMPMATE_SECURE_COOKIES=false
