  "status": "B_COMPONENT_IMPLEMENTED_A_B_FREEZE_AND_PRODUCTION_WIRING_PENDING",
  "shared_schema_version": "1.0",
  "agent_version": "campus-safety-advisory-agent-2",
  "tool_version": "safety-read-only-tools-2",
  "validation_version": "safety-advisory-validation-2",
  "text_policy": {
    "version": "safety-advice-text-2",
    "unicode_data_version": "15.0.0",
    "excluded_unicode_categories": [
      "Cc",
      "Cf",
      "Zl",
      "Zp"
    ],
    "link_like_patterns": [
      "\\b[a-z][a-z0-9+.-]*://",
      "\\b(?:https?|ftps?|sftp|file|mailto|tel|sms|data|javascript):",
      "\\bwww[.\\u3002\\uff0e\\uff61]",
      "(?<![\\w-])(?:[^\\W_](?:[^\\W_]|-){0,62}[.\\u3002\\uff0e\\uff61])+[^\\W\\d_](?:[^\\W\\d_]|-){1,62}(?![\\w-])",
      "\\[[^\\]\\r\\n]*\\]\\(\\s*[^)]*\\)"
    ],
    "regex_flags": [
      "IGNORECASE",
      "UNICODE"
    ],
    "normalisation": "none; reject received text without rewriting",
    "other_existing_exclusions": [
      "numeric literals",
      "matched HTML tags",
      "code fences",
      "selected detectable false-clearance/instruction-injection phrases"
    ],
    "limitations": "Detectable syntax only; not complete URL, obfuscation, English-language or semantic-truth recognition."
  },
  "supported_kernel_rule_pairs": [
    {
      "kernel_version": "b02-v1-rules-2",
      "dataset_rules_version": "b02-v2-rules-2/trip-evidence-selection-1"
    },
    {
      "kernel_version": "b02-v1-rules-2/a-meal-clarification-v1",
      "dataset_rules_version": "b02-v2-rules-2/a-meal-clarification-v1/trip-evidence-selection-1"
    },
    {
      "kernel_version": "b02-v1-rules-2/a-meal-clarification-v1/a-profile-essentials-v1",
      "dataset_rules_version": "b02-v2-rules-2/a-meal-clarification-v1/a-profile-essentials-v1/trip-evidence-selection-1"
    }
  ],
  "prompt_sha256": "348dcee55454f9d25f65e9e4d128858be182e512bc22dabf79f2d286c0865d31",
  "encoded_utf8_limits": {
    "input": 131072,
    "read_facts": 32768,
    "proposal": 24576,
    "action": 32768,
    "complete_audit_payload": 524288,
    "client_request": 131072,
    "client_response": 262144
  },
  "semantic_limits": {
    "findings": 64,
    "catalog_entries": 512,
    "fact_refs_per_finding": 32,
    "baseline_evidence": 128,
    "source_refs": 128,
    "turns_min": 3,
    "turns_max": 6,
    "attempts_per_turn_max": 3
  },
  "notes": [
    "Schemas and versioned pure validators are both required; JSON schema alone is insufficient.",
    "All encoded limits apply together; individual field maxima are not an unlimited cross product.",
    "Advice rejects Unicode Cc/Cf and Zl/Zp, supported link-like syntax, numeric literals, markup and selected detectable false-clearance/injection phrases; no cleaning/normalisation.",
    "English instructions and human review remain necessary; schema cannot prove natural-language truth.",
    "Proposal findings order is preserved; priority is a separate complete permutation.",
    "Source/fact references are added by tools, never accepted in model proposals.",
    "No model safety flag, production migration, audit save port, factory, Hybrid or Orchestrator wiring is enabled by this component."
